{
  "name": "booker-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "The Booker desktop application",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
